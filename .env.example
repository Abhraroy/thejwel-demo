# ==============================================================================
# THE JWEL - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Fill in the appropriate keys and secrets for your local, staging, or production setup.
# Never commit real credentials or .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Required)
# Database, Authentication, and Realtime Backend
# ------------------------------------------------------------------------------
# Public URL for your Supabase project (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase public anonymous API key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-anon-key"

# Supabase service role secret key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used for admin tasks bypassing Row Level Security (RLS) in admin API routes
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"


# ------------------------------------------------------------------------------
# 2. SITE CONFIGURATION & SEO
# Base URLs used for canonical URLs, OpenGraph, Twitter cards, and sitemaps
# ------------------------------------------------------------------------------
# Public base URL of your site (without trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-side fallback site URL (optional fallback if NEXT_PUBLIC_SITE_URL is unset)
SITE_URL="http://localhost:3000"

# Public store/brand display name (used in branding and shipping metadata)
NEXT_PUBLIC_SITE_NAME="The Jwel"


# ------------------------------------------------------------------------------
# 3. RAZORPAY (Payments)
# Required for checkout, order creation, and payment verification
# ------------------------------------------------------------------------------
# Razorpay Key ID used on the client side in checkout modal (rzp_test_... or rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# Razorpay Key ID used server-side for creating Razorpay orders
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# Razorpay Key Secret (SERVER ONLY) used to verify payment signatures and webhooks
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Razorpay Webhook Secret (SERVER ONLY)
# Used to verify signature for razorpay-webhook (/api/payment/razorpay-webhook)
# Ensures automated recovery if user closes browser during checkout
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"


# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS
# Serverless Redis used for checkout sessions, state recovery, and caching
# ------------------------------------------------------------------------------
# Upstash REST URL (e.g. https://<instance>.upstash.io)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"

# Upstash REST Token
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"


# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 (S3-Compatible Object Storage)
# Used for product, category, and review image uploads
# ------------------------------------------------------------------------------
# Cloudflare R2 Access Key ID
CLOUDFLARE_R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"

# Cloudflare R2 Secret Access Key
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"

# Cloudflare R2 Endpoint URL (e.g. https://<account_id>.r2.cloudflarestorage.com)
CLOUDFLARE_R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Cloudflare R2 Bucket Name
CLOUDFLARE_R2_BUCKET_NAME="thejwel-bucket"

# Cloudflare R2 Public CDN Base URL for accessing uploaded media (without trailing slash)
# e.g. https://cdn.thejwel.com or https://pub-<hash>.r2.dev
CLOUDFLARE_R2_PUBLIC_URL="https://cdn.yourdomain.com"


# ------------------------------------------------------------------------------
# 6. META / FACEBOOK TRACKING (Pixel & Conversions API / CAPI)
# ------------------------------------------------------------------------------
# Meta Pixel ID (optional; defaults to built-in fallback ID if omitted)
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"

# Meta Conversions API Access Token (SERVER ONLY)
# Generated in Meta Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN="your-meta-conversions-api-access-token"

# Meta Test Event Code (TESTING ONLY)
# Found in Meta Events Manager -> Test Events tab (e.g. TEST12345).
# LEAVE EMPTY IN PRODUCTION to avoid keeping events in test mode!
META_TEST_EVENT_CODE=""


# ------------------------------------------------------------------------------
# 7. SHIPPING CONFIGURATION (Rates & Policies)
# Controls shipping charges in cart, checkout, and order calculations
# ------------------------------------------------------------------------------
# Standard shipping fee in INR (default: 49)
NEXT_PUBLIC_SHIPPING_FEE="49"

# Order subtotal in INR required to qualify for free shipping (default: 499)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="499"

# Toggle shipping fee calculation: "true" to charge shipping fee, "false" to disable
NEXT_PUBLIC_SHIPPING_ENABLED="true"


# ------------------------------------------------------------------------------
# 8. RAPIDSHYP (Logistics & Order Fulfillment)
# Used for automated shipment booking with courier partners
# ------------------------------------------------------------------------------
# RapidShyp API Authentication Token
RAPIDSHYP_API_KEY="your-rapidshyp-api-token"

# Registered pickup address nickname in RapidShyp dashboard
RAPIDSHYP_PICKUP_ADDRESS_NAME="Primary Warehouse"

# Registered store name in RapidShyp (optional, defaults to NEXT_PUBLIC_SITE_NAME)
RAPIDSHYP_STORE_NAME="The Jwel"

# Default package dimensions (in cm) and weight (in grams/kg)
RAPIDSHYP_PACKAGE_LENGTH="10"
RAPIDSHYP_PACKAGE_BREADTH="10"
RAPIDSHYP_PACKAGE_HEIGHT="5"
RAPIDSHYP_DEFAULT_PACKAGE_WEIGHT="200"


# ------------------------------------------------------------------------------
# 9. TWILIO (SMS Notifications)
# ------------------------------------------------------------------------------
# Twilio Account SID
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Twilio Auth Token
TWILIO_AUTH_TOKEN="your-twilio-auth-token"


# ------------------------------------------------------------------------------
# 10. CUSTOM WEBHOOK AUTHENTICATION (/api/webhook)
# Basic sha256 hash credentials verification for external order webhook
# ------------------------------------------------------------------------------
WEBHOOK_USERNAME="your-webhook-username"
WEBHOOK_PASSWORD="your-webhook-password"


# ------------------------------------------------------------------------------
# 11. DEBUGGING & PERFORMANCE
# ------------------------------------------------------------------------------
# Set to "true" to enable navigation performance logging in browser console
NEXT_PUBLIC_NAV_PERF_DEBUG="false"

# Node environment ("development" | "production" | "test")
# Usually set automatically by Next.js / Vercel
NODE_ENV="development"
